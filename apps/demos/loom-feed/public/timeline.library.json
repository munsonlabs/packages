{
  "format": "loom-library",
  "version": 1,
  "kit": "timeline",
  "sources": ["actions", "event", "gallery", "labels", "live", "podcast", "quote", "reading", "related", "story", "time", "topic", "video"],
  "blocks": ["Avatar", "Badge", "Box", "Button", "Divider", "Icon", "Image", "Link", "Progress", "Repeat", "Stack", "Text", "Video"],
  "widgets": [
    {
      "version": 2,
      "id": "article-card",
      "name": "Article card",
      "kind": "article",
      "vars": {
        "--w-gap": "var(--w-space-3)",
        "--w-radius": "var(--w-radius-md)",
        "--w-padding": "var(--w-space-3)"
      },
      "root": {
        "id": "card",
        "type": "Stack",
        "props": {
          "direction": "column",
          "gap": "var(--w-gap)"
        },
        "on": {
          "click": "actions.open"
        },
        "children": [
          {
            "id": "image",
            "type": "Image",
            "props": {
              "ratio": "16/9"
            },
            "bind": {
              "src": "story.image",
              "alt": "story.title"
            }
          },
          {
            "id": "copy",
            "type": "Stack",
            "props": {
              "direction": "column",
              "gap": "var(--w-space-1)"
            },
            "children": [
              {
                "id": "eyebrow",
                "type": "Stack",
                "props": {
                  "direction": "row",
                  "gap": "var(--w-space-2)",
                  "align": "center"
                },
                "children": [
                  {
                    "id": "label",
                    "type": "Badge",
                    "if": "labels.label",
                    "bind": {
                      "text": "labels.label"
                    }
                  },
                  {
                    "id": "section",
                    "type": "Text",
                    "props": {
                      "variant": "kicker"
                    },
                    "bind": {
                      "text": "story.section"
                    }
                  }
                ]
              },
              {
                "id": "title",
                "type": "Text",
                "props": {
                  "variant": "title",
                  "lines": 3
                },
                "bind": {
                  "text": "story.title"
                }
              },
              {
                "id": "summary",
                "type": "Text",
                "props": {
                  "variant": "body",
                  "lines": 2
                },
                "bind": {
                  "text": "story.summary"
                }
              },
              {
                "id": "byline",
                "type": "Stack",
                "if": "story.author",
                "props": {
                  "direction": "row",
                  "gap": "var(--w-space-2)",
                  "align": "center"
                },
                "children": [
                  {
                    "id": "byline-avatar",
                    "type": "Avatar",
                    "props": {
                      "size": "sm"
                    },
                    "bind": {
                      "src": "story.headshot",
                      "name": "story.author"
                    }
                  },
                  {
                    "id": "byline-name",
                    "type": "Text",
                    "props": {
                      "variant": "caption"
                    },
                    "bind": {
                      "text": "story.author"
                    }
                  }
                ]
              }
            ]
          },
          {
            "id": "progress",
            "type": "Progress",
            "if": "reading.isStarted",
            "bind": {
              "value": "reading.progress"
            }
          },
          {
            "id": "meta",
            "type": "Stack",
            "props": {
              "direction": "row",
              "align": "center",
              "justify": "space-between"
            },
            "children": [
              {
                "id": "when",
                "type": "Stack",
                "props": {
                  "direction": "row",
                  "gap": "var(--w-space-1)",
                  "align": "center"
                },
                "children": [
                  {
                    "id": "time",
                    "type": "Text",
                    "props": {
                      "variant": "caption"
                    },
                    "bind": {
                      "text": "time.ago"
                    }
                  },
                  {
                    "id": "read-time",
                    "type": "Text",
                    "props": {
                      "variant": "caption",
                      "prefix": "· "
                    },
                    "bind": {
                      "text": "reading.label"
                    }
                  }
                ]
              },
              {
                "id": "save",
                "type": "Button",
                "props": {
                  "variant": "outline",
                  "label": "Save",
                  "activeLabel": "Saved"
                },
                "bind": {
                  "active": "story.isSaved"
                },
                "on": {
                  "click": "actions.toggleSave"
                }
              }
            ]
          },
          {
            "id": "related",
            "type": "Stack",
            "if": "related.hasRelated",
            "props": {
              "direction": "column",
              "gap": "var(--w-space-2)"
            },
            "children": [
              {
                "id": "related-rule",
                "type": "Divider"
              },
              {
                "id": "related-label",
                "type": "Text",
                "props": {
                  "variant": "kicker",
                  "text": "Related"
                }
              },
              {
                "id": "related-list",
                "type": "Repeat",
                "props": {
                  "limit": 3,
                  "gap": "var(--w-space-2)"
                },
                "bind": {
                  "items": "related.stories"
                },
                "children": [
                  {
                    "id": "related-title",
                    "type": "Text",
                    "props": {
                      "variant": "subtitle"
                    },
                    "bind": {
                      "text": "item.entry.title"
                    },
                    "on": {
                      "click": {
                        "action": "actions.open",
                        "arg": "item"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "variants": [
        {
          "id": "breaking",
          "label": "Breaking",
          "when": {
            "if": "labels.isBreaking"
          },
          "vars": {
            "--w-accent": "#dc2626"
          },
          "overrides": {
            "image": {
              "hidden": true
            },
            "label": {
              "props": {
                "tone": "alert"
              }
            },
            "title": {
              "props": {
                "lines": 4
              }
            }
          }
        },
        {
          "id": "locked",
          "label": "Subscribers only",
          "when": {
            "if": "story.isLocked"
          },
          "vars": {
            "--w-accent": "#7c3aed"
          },
          "overrides": {
            "card": {
              "order": ["copy", "image"]
            },
            "section": {
              "bind": {
                "text": null
              },
              "props": {
                "text": "Subscribers only"
              }
            },
            "save": {
              "hidden": true
            },
            "related": {
              "hidden": true
            }
          }
        },
        {
          "id": "compact",
          "label": "Compact",
          "when": {
            "size": ["sm"]
          },
          "vars": {
            "--w-gap": "var(--w-space-2)"
          },
          "overrides": {
            "image": {
              "hidden": true
            },
            "summary": {
              "hidden": true
            },
            "related": {
              "hidden": true
            },
            "read-time": {
              "hidden": true
            },
            "title": {
              "props": {
                "variant": "subtitle",
                "lines": 2
              }
            },
            "save": {
              "props": {
                "variant": "ghost"
              }
            }
          }
        }
      ]
    },
    {
      "version": 2,
      "id": "event-card",
      "name": "Event card",
      "kind": "event",
      "vars": {
        "--w-gap": "var(--w-space-3)",
        "--w-accent": "#0f766e",
        "--w-radius": "var(--w-radius-md)",
        "--w-padding": "var(--w-space-3)"
      },
      "root": {
        "id": "card",
        "type": "Stack",
        "props": {
          "direction": "column",
          "gap": "var(--w-gap)"
        },
        "on": {
          "click": "actions.open"
        },
        "children": [
          {
            "id": "image",
            "type": "Image",
            "props": {
              "ratio": "16/9"
            },
            "bind": {
              "src": "story.image",
              "alt": "story.title"
            }
          },
          {
            "id": "heading",
            "type": "Stack",
            "props": {
              "direction": "row",
              "gap": "var(--w-space-3)",
              "align": "center"
            },
            "children": [
              {
                "id": "date-tile",
                "type": "Box",
                "if": "event.day",
                "props": {
                  "align": "center",
                  "gap": "var(--w-space-0)",
                  "padding": "var(--w-space-2) var(--w-space-3)",
                  "background": "var(--w-accent)"
                },
                "style": {
                  "color": "var(--w-accent-contrast)",
                  "min-width": "3.5rem"
                },
                "children": [
                  {
                    "id": "month",
                    "type": "Text",
                    "props": {
                      "variant": "caption"
                    },
                    "bind": {
                      "text": "event.month"
                    },
                    "style": {
                      "color": "inherit"
                    }
                  },
                  {
                    "id": "day",
                    "type": "Text",
                    "props": {
                      "variant": "title"
                    },
                    "bind": {
                      "text": "event.day"
                    },
                    "style": {
                      "color": "inherit"
                    }
                  }
                ]
              },
              {
                "id": "what",
                "type": "Stack",
                "props": {
                  "direction": "column",
                  "gap": "var(--w-space-1)"
                },
                "children": [
                  {
                    "id": "kicker",
                    "type": "Text",
                    "props": {
                      "variant": "kicker"
                    },
                    "bind": {
                      "text": "story.section"
                    }
                  },
                  {
                    "id": "title",
                    "type": "Text",
                    "props": {
                      "variant": "subtitle",
                      "lines": 2
                    },
                    "bind": {
                      "text": "story.title"
                    }
                  }
                ]
              }
            ]
          },
          {
            "id": "details",
            "type": "Stack",
            "props": {
              "direction": "column",
              "gap": "var(--w-space-1)"
            },
            "children": [
              {
                "id": "date-row",
                "type": "Stack",
                "props": {
                  "direction": "row",
                  "gap": "var(--w-space-2)",
                  "align": "center"
                },
                "children": [
                  {
                    "id": "date-icon",
                    "type": "Icon",
                    "props": {
                      "name": "clock",
                      "color": "var(--w-accent)"
                    }
                  },
                  {
                    "id": "date",
                    "type": "Text",
                    "props": {
                      "variant": "caption"
                    },
                    "bind": {
                      "text": "event.date"
                    }
                  }
                ]
              },
              {
                "id": "location-row",
                "type": "Stack",
                "if": "event.location",
                "props": {
                  "direction": "row",
                  "gap": "var(--w-space-2)",
                  "align": "center"
                },
                "children": [
                  {
                    "id": "location-icon",
                    "type": "Icon",
                    "props": {
                      "name": "map-pin",
                      "color": "var(--w-accent)"
                    }
                  },
                  {
                    "id": "location",
                    "type": "Text",
                    "props": {
                      "variant": "caption"
                    },
                    "bind": {
                      "text": "event.location"
                    }
                  }
                ]
              }
            ]
          },
          {
            "id": "summary",
            "type": "Text",
            "props": {
              "variant": "body",
              "lines": 3
            },
            "bind": {
              "text": "story.summary"
            }
          },
          {
            "id": "actions",
            "type": "Stack",
            "props": {
              "direction": "row",
              "gap": "var(--w-space-3)",
              "align": "center"
            },
            "children": [
              {
                "id": "calendar",
                "type": "Button",
                "if": "event.canAddToCalendar",
                "bind": {
                  "label": "event.calendarLabel",
                  "active": "event.isInCalendar"
                },
                "on": {
                  "click": "event.addToCalendar"
                }
              },
              {
                "id": "more",
                "type": "Link",
                "if": "event.href",
                "props": {
                  "text": "Find out more"
                },
                "bind": {
                  "href": "event.href"
                },
                "on": {
                  "click": "event.findOutMore"
                }
              }
            ]
          }
        ]
      },
      "variants": [
        {
          "id": "compact",
          "label": "Compact",
          "when": {
            "size": ["sm"]
          },
          "overrides": {
            "image": {
              "hidden": true
            },
            "summary": {
              "hidden": true
            },
            "details": {
              "hidden": true
            },
            "more": {
              "hidden": true
            }
          }
        }
      ]
    },
    {
      "version": 2,
      "id": "video-tile",
      "name": "Video tile",
      "kind": "video",
      "fixedColors": true,
      "vars": {
        "--w-gap": "var(--w-space-2)",
        "--w-radius": "var(--w-radius-md)",
        "--w-padding": "var(--w-space-2)",
        "--w-bg": "#111113",
        "--w-text": "#f4f4f5",
        "--w-muted": "#a1a1aa",
        "--w-accent": "#f97316"
      },
      "root": {
        "id": "tile",
        "type": "Stack",
        "props": {
          "direction": "column",
          "gap": "var(--w-gap)"
        },
        "children": [
          {
            "id": "player",
            "type": "Video",
            "if": "video.hasVideo",
            "props": {
              "ratio": "16:9"
            },
            "bind": {
              "src": "video.src",
              "poster": "video.poster",
              "label": "story.title"
            }
          },
          {
            "id": "kicker",
            "type": "Text",
            "props": {
              "variant": "kicker"
            },
            "bind": {
              "text": "story.section"
            }
          },
          {
            "id": "title",
            "type": "Text",
            "props": {
              "variant": "subtitle",
              "lines": 2
            },
            "bind": {
              "text": "story.title"
            }
          },
          {
            "id": "meta",
            "type": "Stack",
            "props": {
              "direction": "row",
              "gap": "var(--w-space-1)",
              "align": "center"
            },
            "children": [
              {
                "id": "duration-icon",
                "type": "Icon",
                "props": {
                  "name": "play",
                  "size": "var(--w-text-xs)",
                  "color": "var(--w-accent)"
                }
              },
              {
                "id": "duration",
                "type": "Text",
                "props": {
                  "variant": "caption"
                },
                "bind": {
                  "text": "video.duration"
                }
              },
              {
                "id": "time",
                "type": "Text",
                "props": {
                  "variant": "caption",
                  "prefix": "· "
                },
                "bind": {
                  "text": "time.ago"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "version": 2,
      "id": "gallery-card",
      "name": "Gallery card",
      "kind": "gallery",
      "vars": {
        "--w-gap": "var(--w-space-3)",
        "--w-radius": "var(--w-radius-md)",
        "--w-padding": "var(--w-space-3)"
      },
      "root": {
        "id": "card",
        "type": "Stack",
        "props": {
          "direction": "column",
          "gap": "var(--w-gap)"
        },
        "on": {
          "click": "actions.open"
        },
        "children": [
          {
            "id": "heading",
            "type": "Stack",
            "props": {
              "direction": "column",
              "gap": "var(--w-space-1)"
            },
            "children": [
              {
                "id": "kicker",
                "type": "Text",
                "props": {
                  "variant": "kicker"
                },
                "bind": {
                  "text": "story.section"
                }
              },
              {
                "id": "title",
                "type": "Text",
                "props": {
                  "variant": "title",
                  "lines": 2
                },
                "bind": {
                  "text": "story.title"
                }
              }
            ]
          },
          {
            "id": "photos",
            "type": "Repeat",
            "props": {
              "layout": "carousel",
              "itemWidth": "72%",
              "gap": "var(--w-space-2)",
              "limit": 8
            },
            "bind": {
              "items": "gallery.photos"
            },
            "children": [
              {
                "id": "photo",
                "type": "Stack",
                "props": {
                  "direction": "column",
                  "gap": "var(--w-space-1)"
                },
                "children": [
                  {
                    "id": "photo-image",
                    "type": "Image",
                    "props": {
                      "ratio": "4/3"
                    },
                    "bind": {
                      "src": "item.src",
                      "alt": "item.caption"
                    }
                  },
                  {
                    "id": "photo-caption",
                    "type": "Text",
                    "props": {
                      "variant": "caption",
                      "lines": 1
                    },
                    "bind": {
                      "text": "item.caption"
                    }
                  }
                ]
              }
            ]
          },
          {
            "id": "meta",
            "type": "Stack",
            "props": {
              "direction": "row",
              "gap": "var(--w-space-2)",
              "align": "center"
            },
            "children": [
              {
                "id": "count-icon",
                "type": "Icon",
                "props": {
                  "name": "images",
                  "size": "var(--w-text-sm)",
                  "color": "var(--w-accent)"
                }
              },
              {
                "id": "count",
                "type": "Text",
                "props": {
                  "variant": "caption"
                },
                "bind": {
                  "text": "gallery.countLabel"
                }
              },
              {
                "id": "time",
                "type": "Text",
                "props": {
                  "variant": "caption",
                  "prefix": "· "
                },
                "bind": {
                  "text": "time.ago"
                }
              }
            ]
          }
        ]
      },
      "variants": [
        {
          "id": "compact",
          "label": "Compact",
          "when": {
            "size": ["sm"]
          },
          "overrides": {
            "photos": {
              "props": {
                "itemWidth": "88%"
              }
            },
            "photo-caption": {
              "hidden": true
            },
            "title": {
              "props": {
                "variant": "subtitle"
              }
            }
          }
        }
      ]
    },
    {
      "version": 2,
      "id": "podcast-row",
      "name": "Podcast row",
      "kind": "podcast",
      "vars": {
        "--w-radius": "var(--w-radius-md)",
        "--w-padding": "var(--w-space-3)",
        "--w-accent": "#db2777"
      },
      "root": {
        "id": "row",
        "type": "Stack",
        "props": {
          "direction": "row",
          "gap": "var(--w-space-3)",
          "align": "center"
        },
        "on": {
          "click": "actions.open"
        },
        "children": [
          {
            "id": "artwork",
            "type": "Image",
            "props": {
              "ratio": "1/1"
            },
            "bind": {
              "src": "podcast.artwork",
              "alt": "podcast.show"
            },
            "style": {
              "width": "4.5rem",
              "flex-shrink": "0"
            }
          },
          {
            "id": "about",
            "type": "Stack",
            "props": {
              "direction": "column",
              "gap": "var(--w-space-1)"
            },
            "style": {
              "flex": "1",
              "min-width": "0"
            },
            "children": [
              {
                "id": "show",
                "type": "Text",
                "props": {
                  "variant": "kicker"
                },
                "bind": {
                  "text": "podcast.show"
                }
              },
              {
                "id": "title",
                "type": "Text",
                "props": {
                  "variant": "subtitle",
                  "lines": 2
                },
                "bind": {
                  "text": "story.title"
                }
              },
              {
                "id": "meta",
                "type": "Stack",
                "props": {
                  "direction": "row",
                  "gap": "var(--w-space-1)",
                  "align": "center"
                },
                "children": [
                  {
                    "id": "duration-icon",
                    "type": "Icon",
                    "props": {
                      "name": "headphones",
                      "size": "var(--w-text-xs)",
                      "color": "var(--w-muted)"
                    }
                  },
                  {
                    "id": "duration",
                    "type": "Text",
                    "props": {
                      "variant": "caption"
                    },
                    "bind": {
                      "text": "podcast.duration"
                    }
                  }
                ]
              }
            ]
          },
          {
            "id": "play",
            "type": "Button",
            "props": {
              "label": "Play",
              "activeLabel": "Pause"
            },
            "bind": {
              "active": "podcast.isPlaying"
            },
            "on": {
              "click": "podcast.togglePlay"
            }
          }
        ]
      },
      "variants": [
        {
          "id": "playing",
          "label": "Playing",
          "when": {
            "if": "podcast.isPlaying"
          },
          "overrides": {
            "play": {
              "props": {
                "variant": "outline"
              }
            }
          }
        }
      ]
    },
    {
      "version": 2,
      "id": "live-blog",
      "name": "Live blog",
      "kind": "live",
      "vars": {
        "--w-gap": "var(--w-space-3)",
        "--w-radius": "var(--w-radius-md)",
        "--w-padding": "var(--w-space-3)",
        "--w-accent": "#dc2626"
      },
      "root": {
        "id": "card",
        "type": "Stack",
        "props": {
          "direction": "column",
          "gap": "var(--w-gap)"
        },
        "on": {
          "click": "actions.open"
        },
        "children": [
          {
            "id": "status",
            "type": "Stack",
            "props": {
              "direction": "row",
              "gap": "var(--w-space-2)",
              "align": "center"
            },
            "children": [
              {
                "id": "live-badge",
                "type": "Badge",
                "if": "live.isLive",
                "props": {
                  "text": "Live",
                  "tone": "alert"
                }
              },
              {
                "id": "updated",
                "type": "Text",
                "props": {
                  "variant": "caption"
                },
                "bind": {
                  "text": "live.lastUpdated"
                }
              }
            ]
          },
          {
            "id": "title",
            "type": "Text",
            "props": {
              "variant": "title",
              "lines": 3
            },
            "bind": {
              "text": "story.title"
            }
          },
          {
            "id": "updates",
            "type": "Repeat",
            "props": {
              "limit": 3,
              "gap": "var(--w-space-2)"
            },
            "bind": {
              "items": "live.updates"
            },
            "children": [
              {
                "id": "update",
                "type": "Stack",
                "props": {
                  "direction": "row",
                  "gap": "var(--w-space-3)"
                },
                "children": [
                  {
                    "id": "update-time",
                    "type": "Text",
                    "props": {
                      "variant": "caption"
                    },
                    "bind": {
                      "text": "item.clock"
                    },
                    "style": {
                      "color": "var(--w-accent)",
                      "font-weight": "var(--w-weight-bold)",
                      "min-width": "3rem"
                    }
                  },
                  {
                    "id": "update-text",
                    "type": "Text",
                    "props": {
                      "variant": "body",
                      "lines": 2
                    },
                    "bind": {
                      "text": "item.text"
                    }
                  }
                ]
              }
            ]
          },
          {
            "id": "follow",
            "type": "Link",
            "props": {
              "text": "Follow the latest"
            },
            "on": {
              "click": "actions.open"
            }
          }
        ]
      },
      "variants": [
        {
          "id": "ended",
          "label": "Ended",
          "when": {
            "if": "!live.isLive"
          },
          "vars": {
            "--w-accent": "var(--w-muted)"
          },
          "overrides": {
            "updates": {
              "props": {
                "limit": 1
              }
            },
            "follow": {
              "props": {
                "text": "Read the full coverage"
              }
            }
          }
        },
        {
          "id": "compact",
          "label": "Compact",
          "when": {
            "size": ["sm"]
          },
          "overrides": {
            "updates": {
              "props": {
                "limit": 1
              }
            },
            "title": {
              "props": {
                "variant": "subtitle",
                "lines": 2
              }
            },
            "follow": {
              "hidden": true
            }
          }
        }
      ]
    },
    {
      "version": 2,
      "id": "pull-quote",
      "name": "Pull quote",
      "kind": "quote",
      "vars": {
        "--w-radius": "var(--w-radius-md)",
        "--w-padding": "var(--w-space-4)"
      },
      "root": {
        "id": "card",
        "type": "Stack",
        "props": {
          "direction": "column",
          "gap": "var(--w-space-3)"
        },
        "on": {
          "click": "actions.open"
        },
        "style": {
          "border-left-width": "4px",
          "border-left-style": "solid",
          "border-left-color": "var(--w-accent)"
        },
        "children": [
          {
            "id": "mark",
            "type": "Icon",
            "props": {
              "name": "quote",
              "size": "var(--w-text-2xl)",
              "color": "var(--w-accent)"
            },
            "style": {
              "align-self": "flex-start"
            }
          },
          {
            "id": "text",
            "type": "Text",
            "props": {
              "variant": "title",
              "prefix": "“",
              "suffix": "”"
            },
            "bind": {
              "text": "quote.text"
            },
            "style": {
              "font-style": "italic"
            }
          },
          {
            "id": "attribution",
            "type": "Text",
            "props": {
              "variant": "caption",
              "prefix": "— "
            },
            "bind": {
              "text": "quote.attribution"
            }
          },
          {
            "id": "topic-row",
            "type": "Stack",
            "if": "topic.name",
            "props": {
              "direction": "row",
              "align": "center",
              "justify": "space-between"
            },
            "children": [
              {
                "id": "topic",
                "type": "Text",
                "props": {
                  "variant": "kicker"
                },
                "bind": {
                  "text": "topic.name"
                }
              },
              {
                "id": "follow",
                "type": "Button",
                "props": {
                  "variant": "ghost",
                  "label": "Follow",
                  "activeLabel": "Following"
                },
                "bind": {
                  "active": "topic.isFollowed"
                },
                "on": {
                  "click": "topic.toggleFollow"
                }
              }
            ]
          }
        ]
      }
    }
  ]
}

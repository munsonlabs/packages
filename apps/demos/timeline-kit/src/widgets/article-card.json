{
  "version": 2,
  "id": "article-card",
  "name": "Article card",
  "kind": "article",
  "vars": { "--w-gap": "var(--w-space-3)", "--w-radius": "var(--w-radius-md)", "--w-padding": "var(--w-space-3)" },
  "root": {
    "id": "card",
    "type": "Stack",
    "props": { "direction": "column", "gap": "var(--w-gap)" },
    "on": { "click": "actions.open" },
    "children": [
      { "id": "image", "type": "Image", "props": { "ratio": "16/9" }, "bind": { "src": "story.image", "alt": "story.title" } },
      {
        "id": "copy",
        "type": "Stack",
        "props": { "direction": "column", "gap": "var(--w-space-1)" },
        "children": [
          {
            "id": "eyebrow",
            "type": "Stack",
            "props": { "direction": "row", "gap": "var(--w-space-2)", "align": "center" },
            "children": [
              { "id": "label", "type": "Badge", "if": "labels.label", "bind": { "text": "labels.label" } },
              { "id": "section", "type": "Text", "props": { "variant": "kicker" }, "bind": { "text": "story.section" } }
            ]
          },
          { "id": "title", "type": "Text", "props": { "variant": "title", "lines": 3 }, "bind": { "text": "story.title" } },
          { "id": "summary", "type": "Text", "props": { "variant": "body", "lines": 2 }, "bind": { "text": "story.summary" } },
          {
            "id": "byline",
            "type": "Stack",
            "if": "story.author",
            "props": { "direction": "row", "gap": "var(--w-space-2)", "align": "center" },
            "children": [
              { "id": "byline-avatar", "type": "Avatar", "props": { "size": "sm" }, "bind": { "src": "story.headshot", "name": "story.author" } },
              { "id": "byline-name", "type": "Text", "props": { "variant": "caption" }, "bind": { "text": "story.author" } }
            ]
          }
        ]
      },
      { "id": "progress", "type": "Progress", "if": "reading.isStarted", "bind": { "value": "reading.progress" } },
      {
        "id": "meta",
        "type": "Stack",
        "props": { "direction": "row", "align": "center", "justify": "space-between" },
        "children": [
          {
            "id": "when",
            "type": "Stack",
            "props": { "direction": "row", "gap": "var(--w-space-1)", "align": "center" },
            "children": [
              { "id": "time", "type": "Text", "props": { "variant": "caption" }, "bind": { "text": "time.ago" } },
              { "id": "read-time", "type": "Text", "props": { "variant": "caption", "prefix": "· " }, "bind": { "text": "reading.label" } }
            ]
          },
          {
            "id": "save",
            "type": "Button",
            "props": { "variant": "outline", "label": "Save", "activeLabel": "Saved" },
            "bind": { "active": "story.isSaved" },
            "on": { "click": "actions.toggleSave" }
          }
        ]
      },
      {
        "id": "related",
        "type": "Stack",
        "if": "related.hasRelated",
        "props": { "direction": "column", "gap": "var(--w-space-2)" },
        "children": [
          { "id": "related-rule", "type": "Divider" },
          { "id": "related-label", "type": "Text", "props": { "variant": "kicker", "text": "Related" } },
          {
            "id": "related-list",
            "type": "Repeat",
            "props": { "limit": 3, "gap": "var(--w-space-2)" },
            "bind": { "items": "related.stories" },
            "children": [
              {
                "id": "related-title",
                "type": "Text",
                "props": { "variant": "subtitle" },
                "bind": { "text": "item.entry.title" },
                "on": { "click": { "action": "actions.open", "arg": "item" } }
              }
            ]
          }
        ]
      }
    ]
  },
  "variants": [
    {
      "id": "breaking",
      "label": "Breaking",
      "when": { "if": "labels.isBreaking" },
      "vars": { "--w-accent": "#dc2626" },
      "overrides": {
        "image": { "hidden": true },
        "label": { "props": { "tone": "alert" } },
        "title": { "props": { "lines": 4 } }
      }
    },
    {
      "id": "locked",
      "label": "Subscribers only",
      "when": { "if": "story.isLocked" },
      "vars": { "--w-accent": "#7c3aed" },
      "overrides": {
        "card": { "order": ["copy", "image"] },
        "section": { "bind": { "text": null }, "props": { "text": "Subscribers only" } },
        "save": { "hidden": true },
        "related": { "hidden": true }
      }
    },
    {
      "id": "compact",
      "label": "Compact",
      "when": { "size": ["sm"] },
      "vars": { "--w-gap": "var(--w-space-2)" },
      "overrides": {
        "image": { "hidden": true },
        "summary": { "hidden": true },
        "related": { "hidden": true },
        "read-time": { "hidden": true },
        "title": { "props": { "variant": "subtitle", "lines": 2 } },
        "save": { "props": { "variant": "ghost" } }
      }
    }
  ]
}

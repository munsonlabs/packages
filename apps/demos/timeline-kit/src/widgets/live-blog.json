{
  "version": 2,
  "id": "live-blog",
  "name": "Live blog",
  "match": [{ "path": "entry.type", "op": "equals", "value": "liveblog" }],
  "uses": ["story", "actions", "live"],
  "vars": { "--w-gap": "var(--w-space-3)", "--w-radius": "var(--w-radius-md)", "--w-padding": "var(--w-space-3)", "--w-accent": "#dc2626" },
  "root": {
    "id": "card",
    "type": "Stack",
    "props": { "direction": "column", "gap": "var(--w-gap)" },
    "on": { "click": "actions.open" },
    "children": [
      {
        "id": "status",
        "type": "Stack",
        "props": { "direction": "row", "gap": "var(--w-space-2)", "align": "center" },
        "children": [
          { "id": "live-badge", "type": "Badge", "if": "live.isLive", "props": { "text": "Live", "tone": "alert" } },
          { "id": "updated", "type": "Text", "props": { "variant": "caption" }, "bind": { "text": "live.lastUpdated" } }
        ]
      },
      { "id": "title", "type": "Text", "props": { "variant": "title", "lines": 3 }, "bind": { "text": "story.title" } },
      {
        "id": "updates",
        "type": "Repeat",
        "props": { "limit": 3, "gap": "var(--w-space-2)" },
        "bind": { "items": "live.updates" },
        "children": [
          {
            "id": "update",
            "type": "Stack",
            "props": { "direction": "row", "gap": "var(--w-space-3)" },
            "children": [
              {
                "id": "update-time",
                "type": "Text",
                "props": { "variant": "caption" },
                "bind": { "text": "item.clock" },
                "style": { "color": "var(--w-accent)", "font-weight": "var(--w-weight-bold)", "min-width": "3rem" }
              },
              { "id": "update-text", "type": "Text", "props": { "variant": "body", "lines": 2 }, "bind": { "text": "item.text" } }
            ]
          }
        ]
      },
      { "id": "follow", "type": "Link", "props": { "text": "Follow the latest" }, "on": { "click": "actions.open" } }
    ]
  },
  "variants": [
    {
      "id": "ended",
      "label": "Ended",
      "when": { "if": "!live.isLive" },
      "vars": { "--w-accent": "var(--w-muted)" },
      "overrides": { "updates": { "props": { "limit": 1 } }, "follow": { "props": { "text": "Read the full coverage" } } }
    },
    {
      "id": "compact",
      "label": "Compact",
      "when": { "size": ["sm"] },
      "overrides": {
        "updates": { "props": { "limit": 1 } },
        "title": { "props": { "variant": "subtitle", "lines": 2 } },
        "follow": { "hidden": true }
      }
    }
  ]
}

{
  "name": "@munsonlabs/loom",
  "version": "0.0.0",
  "private": true,
  "description": "Widgets as data: JSON trees of blocks bound to your own composables, with variants by rule and kinds of data. Render them with <Widget>.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/munsonlabs/packages.git",
    "directory": "packages/loom"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/**/*.css"
  ],
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "source": "./src/index.js",
      "import": "./dist/index.mjs"
    },
    "./editor": {
      "source": "./src/editor.js",
      "import": "./dist/editor.mjs"
    },
    "./style.css": {
      "source": "./src/theme/styles.css",
      "import": "./dist/style.css"
    },
    "./video": {
      "source": "./src/blocks/video/index.js",
      "import": "./dist/video.mjs"
    },
    "./icon": {
      "source": "./src/blocks/icon/index.js",
      "import": "./dist/icon.mjs"
    }
  },
  "scripts": {
    "dev": "vp pack --watch",
    "build": "vp pack",
    "clean": "rm -rf dist",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "check": "vp check",
    "test": "vp test",
    "test:watch": "vp test --watch"
  },
  "devDependencies": {
    "@munsonlabs/shipkit": "*",
    "@munsonlabs/sigil": "*",
    "@munsonlabs/video-player": "*",
    "@types/node": "^25.5.0",
    "@vue/test-utils": "^2.4.6",
    "vue": "3.5.42"
  },
  "peerDependencies": {
    "@munsonlabs/sigil": "*",
    "@munsonlabs/video-player": "*",
    "vue": ">=3"
  },
  "peerDependenciesMeta": {
    "@munsonlabs/video-player": {
      "optional": true
    },
    "@munsonlabs/sigil": {
      "optional": true
    }
  }
}

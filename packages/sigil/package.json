{
  "name": "@munsonlabs/sigil",
  "version": "0.0.0",
  "description": "Framework-free icon registry with a <ml-sigil> custom element. Register SVG libraries or icon fonts by describing them; the registry loads what it needs.",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/element.mjs"
  ],
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    },
    "./element": {
      "source": "./src/element/index.ts",
      "import": "./dist/element.mjs",
      "types": "./dist/element.d.mts"
    },
    "./vue": {
      "source": "./src/vue.ts",
      "import": "./dist/vue.mjs",
      "types": "./dist/vue.d.mts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vp pack --watch",
    "build": "vp pack",
    "clean": "rm -rf dist",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "typecheck": "vp check --types",
    "check": "vp check",
    "test": "vp test",
    "test:watch": "vp test --watch"
  },
  "devDependencies": {
    "@munsonlabs/shipkit": "*",
    "@vue/test-utils": "^2.4.6",
    "vue": "3.5.33"
  },
  "peerDependencies": {
    "vue": ">=3"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  }
}
